# Copy this file to ".env" and edit the values. Never commit ".env".

# Generate a key with (works in PowerShell, cmd and bash):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-key

# Keep True for local development (needed so the Admin's CSS is served by runserver).
# Set to False for anything public.
DEBUG=True

# Comma-separated hostnames the server may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone used to display/enter datetimes in Admin and in API output.
# Data is always STORED in UTC. Examples: UTC, Asia/Karachi
TIME_ZONE=UTC
